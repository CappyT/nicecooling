    <property name="RuleGroupState" type="a(sbt)" access="read"/>
    <!-- Ordered list of Rule groups: (group id, target profile, enabled, rules). A rule is (kind sensor|process|time|interval, parameters); api.md gives the keys of each kind. -->
    <method name="GetRuleGroups">
