<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  D-Bus contract of nicecoolingd. api.md gives the semantics, the identifiers and the errors.
  Each method carries the annotation io.github.cappyt.NiceCooling1.Authorization:
    read             no polkit check
    write            action io.github.cappyt.NiceCooling1.write
    critical         action io.github.cappyt.NiceCooling1.critical
    cancel-poweroff  action io.github.cappyt.NiceCooling1.cancel-poweroff
    write-or-critical: critical when the argument is release, else write
  Properties with EmitsChangedSignal=false change on every tick; SensorsUpdated carries their values.
-->
<node>

  <!-- Object path: /io/github/cappyt/NiceCooling1. Also implements org.freedesktop.DBus.ObjectManager. -->
  <interface name="io.github.cappyt.NiceCooling1.Manager">
    <property name="Version" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- ok | last-known-good | empty -->
    <property name="StateHealth" type="s" access="read"/>

    <method name="CreateDerivedSensor">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
      <!-- maximum | mean | difference -->
      <arg name="type" type="s" direction="in"/>
      <arg name="sources" type="ao" direction="in"/>
      <arg name="sensor" type="o" direction="out"/>
    </method>
    <!-- The new Loop has no links and a Pump floor of 40%, the value of the UI design. -->
    <method name="CreateLoop">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="loop" type="o" direction="out"/>
    </method>
    <!-- (id, name, preset, points as (raw rpm, flow L/h)) -->
    <method name="GetCalibrationTables">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="tables" type="a(ssba(dd))" direction="out"/>
    </method>
    <!-- An empty id creates a table. A preset id fails with ReadOnly. -->
    <method name="SetCalibrationTable">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="id" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="points" type="a(dd)" direction="in"/>
      <arg name="table_id" type="s" direction="out"/>
    </method>
    <method name="DeleteCalibrationTable">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="id" type="s" direction="in"/>
    </method>

    <!-- One signal per tick. A sensor entry is (id, value, flags). A Channel entry is
         (id, Duty, smoothed Input, Curve target, flags). api.md defines the flags. -->
    <signal name="SensorsUpdated">
      <arg name="time_us" type="t"/>
      <arg name="sensors" type="a(sdy)"/>
      <arg name="channels" type="a(sdddy)"/>
    </signal>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1/board -->
  <interface name="io.github.cappyt.NiceCooling1.Board">
    <!-- DMI board_vendor and board_name -->
    <property name="Vendor" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Model" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- Board file id, empty for an unknown Board -->
    <property name="BoardFile" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1/sensor/<sensor id> -->
  <interface name="io.github.cappyt.NiceCooling1.Sensor">
    <property name="Id" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Name" type="s" access="read"/>
    <property name="DefaultName" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- temperature | fan | flow | voltage | current | power | pressure | level | other -->
    <property name="Kind" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- degC | rpm | l/h | V | A | W | mbar | mbar/min | ml | ml/h | s | % | empty -->
    <property name="Unit" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- hwmon | leakshield | derived | calibrated -->
    <property name="Origin" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- hwmon name attribute, empty when Origin is not hwmon -->
    <property name="Driver" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Value" type="d" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>
    <property name="HasValue" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>
    <!-- An empty name restores DefaultName. -->
    <method name="SetName">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
    </method>
  </interface>

  <!-- Also on /io/github/cappyt/NiceCooling1/sensor/<sensor id> when Origin is derived -->
  <interface name="io.github.cappyt.NiceCooling1.DerivedSensor">
    <property name="Type" type="s" access="read"/>
    <property name="Sources" type="ao" access="read"/>
    <method name="SetDefinition">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="type" type="s" direction="in"/>
      <arg name="sources" type="ao" direction="in"/>
    </method>
    <!-- Fails with InUse while a Curve, a Loop or a Profile rule reads the sensor. -->
    <method name="Delete">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1/channel/<channel id> -->
  <interface name="io.github.cappyt.NiceCooling1.Channel">
    <property name="Id" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Name" type="s" access="read"/>
    <property name="DefaultName" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- Output in percent, from the last reconcile read-back -->
    <property name="Duty" type="d" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>
    <property name="Raw" type="y" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>
    <!-- hardware | curve | fixed -->
    <property name="Control" type="s" access="read"/>
    <!-- none | lost-input | pump-stop -->
    <property name="Override" type="s" access="read"/>
    <property name="IsPump" type="b" access="read"/>
    <property name="ManualAtSnapshot" type="b" access="read"/>
    <!-- (input sensor, points as (input, duty), smoothing s, step limit %/s); input is / when Control is not curve -->
    <property name="Curve" type="(oa(dd)dd)" access="read"/>
    <property name="FixedDuty" type="d" access="read"/>
    <!-- (snapshot time, attributes as (name, value) in restore order). (0, []) when the daemon holds no snapshot. -->
    <property name="BiosSnapshot" type="(ta(ss))" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <!-- The sensor <chip>_fan<N> of <chip>_pwm<N>, or / when it does not exist. -->
    <property name="FanSensor" type="o" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>

    <method name="SetName">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
    </method>
    <method name="SetCurve">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="input" type="o" direction="in"/>
      <arg name="points" type="a(dd)" direction="in"/>
      <arg name="smoothing_s" type="d" direction="in"/>
      <arg name="step_limit_pct_per_s" type="d" direction="in"/>
    </method>
    <method name="SetFixedDuty">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="duty" type="d" direction="in"/>
    </method>
    <!-- Gives the Channel back to its Hardware curve: restores its BIOS snapshot attributes. -->
    <method name="ReleaseToHardware">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1/loop/<loop id> -->
  <interface name="io.github.cappyt.NiceCooling1.Loop">
    <property name="Id" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Name" type="s" access="read"/>
    <property name="PumpChannels" type="ao" access="read"/>
    <!-- Raw flow sensor and Calibration table id; / and empty when not set -->
    <property name="FlowSensor" type="o" access="read"/>
    <property name="CalibrationTable" type="s" access="read"/>
    <!-- The calibrated flow sensor that the daemon creates for this Loop, / when not set -->
    <property name="Flow" type="o" access="read"/>
    <property name="WaterTemperature" type="o" access="read"/>
    <property name="Leakshield" type="o" access="read"/>
    <property name="PumpFloor" type="d" access="read"/>

    <method name="SetName">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
    </method>
    <method name="SetPumpChannels">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="channels" type="ao" direction="in"/>
    </method>
    <method name="SetFlowSensor">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="sensor" type="o" direction="in"/>
      <arg name="calibration_table" type="s" direction="in"/>
    </method>
    <method name="SetWaterTemperature">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="sensor" type="o" direction="in"/>
    </method>
    <method name="SetLeakshield">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="leakshield" type="o" direction="in"/>
    </method>
    <method name="SetPumpFloor">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="duty" type="d" direction="in"/>
    </method>
    <method name="Delete">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1/leakshield/<leakshield id> -->
  <interface name="io.github.cappyt.NiceCooling1.Leakshield">
    <property name="Id" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Serial" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Firmware" type="q" access="read"/>
    <property name="Structure" type="q" access="read"/>
    <property name="Connected" type="b" access="read"/>
    <property name="Writable" type="b" access="read"/>
    <!-- Empty when Writable, else a reason identifier from api.md -->
    <property name="ReadOnlyReason" type="s" access="read"/>
    <!-- shield | monitor | release, empty while unknown -->
    <property name="Mode" type="s" access="read"/>
    <!-- test | measure-fill-level | deaerate | refill, empty when no Action runs -->
    <property name="RunningAction" type="s" access="read"/>
    <!-- Device time minus PC time, in seconds -->
    <property name="ClockOffset" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="false"/>
    </property>
    <property name="SoftwareSensorSlots" type="q" access="read"/>
    <!-- off | waiting | ok | failing: the state of the Feed message. api.md defines it. -->
    <property name="FeedState" type="s" access="read"/>
    <!-- (time of the last good send in microseconds, pump speed in rpm, flow in L/h); (0, 0, 0) before the first one -->
    <property name="LastFeed" type="(tdd)" access="read"/>
    <!-- active_profile of report 1, 0 when not known -->
    <property name="ActiveSlot" type="y" access="read"/>
    <!-- The backup id of the last Profile write that failed. Empty after a good Profile write and after RestoreBackup. -->
    <property name="FailedWriteBackup" type="s" access="read"/>

    <!-- (field id, risk class safety|low, value, writable, reason) -->
    <method name="GetFields">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="fields" type="a(ssvbs)" direction="out"/>
    </method>
    <!-- One write path run for all fields. Returns after the read-back. Mode is not a field here. -->
    <method name="SetFields">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="fields" type="a{sv}" direction="in"/>
    </method>
    <!-- The stored settings of a slot (1 to 4), as field id to value. They use the variant types of GetFields. The device is not
         read. Fails with NotFound for a slot with no stored report 3 and with NotSupported for a firmware that the registry
         does not cover. -->
    <method name="GetStoredFields">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="slot" type="y" direction="in"/>
      <arg name="fields" type="a{sv}" direction="out"/>
    </method>
    <!-- Changes the stored report 3 of another slot and sends nothing to the device. The slot of ActiveSlot fails with InvalidArgument:
         use SetFields. The next activation of the slot uses the verified write path. -->
    <method name="SetStoredFields">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="slot" type="y" direction="in"/>
      <arg name="fields" type="a{sv}" direction="in"/>
    </method>
    <method name="SetMode">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write-or-critical"/>
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="StartAction">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="action" type="s" direction="in"/>
    </method>
    <!-- Sends cancel_action (command 12, code 0). Fails with NotSupported when the registry of this firmware has no such command. -->
    <method name="CancelAction">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sets the device clock from the PC clock now, whatever the offset. -->
    <method name="SyncClock">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sends reset_alarm (command 11, parameter 0), which clears the latched alarm bits of the device. Fails with NotSupported when the registry of this firmware has no such command, and with ReadOnly on a firmware that the registry does not cover. -->
    <method name="ResetAlarms">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sends reset_refill_history (command 13). Fails with NotSupported when the registry of this firmware has no such command. -->
    <method name="ResetRefillHistory">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sends reset_event_log (command 14, parameter 0), which clears the event list of the device. Fails with NotSupported when the registry of this firmware has no such command, and with ReadOnly on a firmware that the registry does not cover. -->
    <method name="ResetEventLog">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sends set_fill_mode (command 15, parameter 0), which pauses a running Refill and resumes a paused one. The errors of ResetEventLog apply. -->
    <method name="ToggleRefillPause">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Sends reset_service_counter (command 25000, serial XOR 0xFFFFFFFF). Fails with NotSupported when the registry of this firmware has no such command. -->
    <method name="ResetServiceCounter">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
    </method>
    <!-- Counter name to value, from report 1: pump_runtime_s, pump_short_cycle_runtime_s, pump_revolution_count, fill_valve_cycles,
         release_valve_cycles, total_runtime_s, power_up_count. api.md gives the units. -->
    <method name="GetCounters">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="counters" type="a{st}" direction="out"/>
    </method>
    <!-- The refill history of the daemon, oldest first: (device time us, duration s, pump revolutions, volume ml). It holds each refill
         entry of report 1 for 90 days. The device is not read. api.md gives the rules. -->
    <method name="GetRefillHistory">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="refills" type="a(tuud)" direction="out"/>
    </method>
    <!-- (device time us, event identifier, details) -->
    <method name="GetEvents">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="events" type="a(tsa{sv})" direction="out"/>
    </method>
    <method name="GetSoftwareSensors">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="slots" type="a(qo)" direction="out"/>
    </method>
    <!-- sensor / clears the slot -->
    <method name="SetSoftwareSensor">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="slot" type="q" direction="in"/>
      <arg name="sensor" type="o" direction="in"/>
    </method>
    <!-- The image that display page `page` (0 to 9) shows, as width, height and rows: 128 x 64, rows from the top, each row 16 bytes,
         bit 7 the leftmost pixel, 1 lit. The call sends show_page for 30 s, waits 200 ms and reads report 5. It stores no setting,
         so it needs no authorization. Fails with InvalidArgument for a page above 9, ReadOnly for a device that is read-only,
         NotSupported when the registry lacks show_page, Disconnected, and PageNotShown when the device shows another page. -->
    <method name="GetDisplayPreview">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="page" type="y" direction="in"/>
      <arg name="width" type="q" direction="out"/>
      <arg name="height" type="q" direction="out"/>
      <arg name="rows" type="ay" direction="out"/>
    </method>
    <!-- The display assets of report 8, read from the device: 40 names (0-19 device sensors, 20-34 page texts, 35-38 LED controllers,
         39 LED strip), 16 icons of 23 x 23 pixels and the logo of 128 x 64 pixels. A bitmap is (width, height, rows) as in
         GetDisplayPreview. -->
    <method name="GetDisplayAssets">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="names" type="as" direction="out"/>
      <arg name="icons" type="a(qqay)" direction="out"/>
      <arg name="logo" type="(qqay)" direction="out"/>
    </method>
    <!-- Writes one asset of report 8: a backup first, then report 8 with the new CRC, 250 ms later a read-back that must equal the
         written report, and save_settings 4 s after the last write. Fails with InvalidArgument for an index out of range, a text
         with a character that Windows-1252 lacks, a control character or more than 23 bytes, and a bitmap of another size or with
         a wrong byte count. Other errors: ReadOnly, VerifyFailed (the message holds the backup id), Busy, Disconnected. -->
    <method name="SetDisplayName">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="index" type="y" direction="in"/>
      <arg name="text" type="s" direction="in"/>
    </method>
    <!-- index 0 to 15, 23 x 23 pixels -->
    <method name="SetDisplayIcon">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="index" type="y" direction="in"/>
      <arg name="width" type="q" direction="in"/>
      <arg name="height" type="q" direction="in"/>
      <arg name="rows" type="ay" direction="in"/>
    </method>
    <!-- 128 x 64 pixels -->
    <method name="SetDisplayLogo">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="width" type="q" direction="in"/>
      <arg name="height" type="q" direction="in"/>
      <arg name="rows" type="ay" direction="in"/>
    </method>
    <!-- (backup id, time us, sha256 hex, firmware, reason first|before-write|manual|import) -->
    <method name="ListBackups">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="backups" type="a(stsqs)" direction="out"/>
    </method>
    <method name="CreateBackup">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="backup" type="s" direction="out"/>
    </method>
    <!-- The firmware of the backup, then reports 3, 5 and 8, each with its report ID byte, for an export by the app -->
    <method name="GetBackup">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="backup" type="s" direction="in"/>
      <arg name="firmware" type="q" direction="out"/>
      <arg name="report3" type="ay" direction="out"/>
      <arg name="report5" type="ay" direction="out"/>
      <arg name="report8" type="ay" direction="out"/>
    </method>
    <!-- firmware is the one that GetBackup returned. Fails with NotSupported when the field registry does not cover it, and with InvalidArgument for a wrong size, a bad CRC, a field out of range or another structure id than the device has. -->
    <method name="ImportBackup">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="firmware" type="q" direction="in"/>
      <arg name="report3" type="ay" direction="in"/>
      <arg name="report5" type="ay" direction="in"/>
      <arg name="report8" type="ay" direction="in"/>
      <arg name="backup" type="s" direction="out"/>
    </method>
    <method name="RestoreBackup">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="critical"/>
      <arg name="backup" type="s" direction="in"/>
    </method>
    <method name="FactoryReset">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="critical"/>
    </method>
    <!-- (device alarm id, current Device response, proposed Device response, overlap warning id or empty) -->
    <method name="GetDeviceResponseProposals">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="read"/>
      <arg name="proposals" type="a(ssss)" direction="out"/>
    </method>

    <!-- Field ids that changed outside the volatile mask and not by the daemon -->
    <signal name="ExternalChange">
      <arg name="fields" type="as"/>
    </signal>
    <!-- A write or the save-settings command after it failed. backup is the backup the restore offer uses. -->
    <signal name="WriteFailed">
      <arg name="error" type="s"/>
      <arg name="backup" type="s"/>
    </signal>
  </interface>

  <!-- Object path: /io/github/cappyt/NiceCooling1 -->
  <interface name="io.github.cappyt.NiceCooling1.Profiles">
    <property name="Active" type="o" access="read"/>
    <!-- default | rule | manual -->
    <property name="ActivationCause" type="s" access="read"/>
    <!-- applied | leakshield-failed -->
    <property name="ActiveState" type="s" access="read"/>
    <property name="Default" type="o" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="ImmediateSwitching" type="b" access="read"/>
    <property name="RuleDelaySeconds" type="u" access="read"/>
    <property name="DwellSeconds" type="u" access="read"/>
    <!-- The end of the running Profile dwell in microseconds since the Unix epoch, 0 when no dwell runs. api.md gives the rule. -->
    <property name="DwellUntil" type="t" access="read"/>

    <!-- copy_from / creates the Profile from the current state. The new Profile takes the Leakshield slot of the Profile it copies (of the active Profile for /). -->
    <method name="CreateProfile">
      <annotation name="io.github.cappyt.NiceCooling1.Authorization" value="write"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="copy_from" type="o" direction="in"/>
      <arg name="profile" type="o" direction="out"/>
