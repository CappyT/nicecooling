// Install path: /usr/share/polkit-1/rules.d/50-nicecooling.rules
// The action `critical` has no rule: it always asks for the administrator password.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id == "io.github.cappyt.NiceCooling1.write" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
    if (action.id == "io.github.cappyt.NiceCooling1.cancel-poweroff" && subject.local) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
