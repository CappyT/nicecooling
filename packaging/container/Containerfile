# Image for the checks of the RPM: Fedora with systemd as PID 1, the bus and polkit.
# `packaging/container/check.sh` builds it, starts it, installs the RPM in it and runs the checks.
ARG FEDORA_VERSION=latest
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf -y install systemd dbus-broker polkit && dnf clean all

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
