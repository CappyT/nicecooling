# Image for the checks of the systemd unit of the daemon on Fedora.
# `packaging/container/check.sh` builds it from the repository root, after
# `cargo build --release -p nicecoolingd`, and runs `systemd-analyze verify` and `systemctl show`.
ARG FEDORA_VERSION=latest
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

RUN dnf -y install systemd && dnf clean all

COPY target/release/nicecoolingd /usr/libexec/nicecoolingd
COPY packaging/nicecoolingd.service /usr/lib/systemd/system/nicecoolingd.service

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/lib/systemd/systemd"]
